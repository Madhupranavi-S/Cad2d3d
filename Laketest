"""
Inference + Paper-Quality Plot
==============================
Loads the trained TCN model and runs classification on extracted bag CSVs
(or test_trajectories.csv). Produces:

  1. One plot per trajectory  →  path coloured by predicted class  (paper figures)
  2. One overview plot        →  all trajectories side-by-side
  3. A summary CSV            →  traj_id, true_label, pred_label, confidence

Usage:
    # Use the test CSV that came with training
    python3 infer_and_plot.py --csv test_trajectories.csv

    # Use a bag-extracted CSV (from ros2_bag_extractor.py)
    python3 infer_and_plot.py --csv ~/extracted/ALL_BAGS_COMBINED.csv --no_true_label

    # Specific trajectory IDs only
    python3 infer_and_plot.py --csv test_trajectories.csv --traj_ids 0 3 7
"""

import os
import argparse
import math
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import torch
import torch.nn as nn
import torch.nn.functional as F
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
import matplotlib.colors as mcolors
from matplotlib.collections import LineCollection
import joblib
from scipy.linalg import cholesky

# ═══════════════════════════════════════════════════════════════════════════════
# CONFIG  — match exactly what you used during training
# ═══════════════════════════════════════════════════════════════════════════════

MODEL_PATH  = "tcn_motion_model_naug2.pth"
SCALER_PATH = "trajectory_scaler_naug2.pkl"

WINDOW_SIZE   = 100
STRIDE        = 10       # slide window every STRIDE steps during inference
EMBEDDING_DIM = 64
DROPOUT_RATE  = 0.2
DT            = 0.1

# Class names — update these once you have real labels
CLASS_NAMES = {
    0: "Class 0",
    1: "Class 1",
    2: "Class 2",
    3: "Class 3",
}

# Colour palette — distinct, print-safe, colourblind-friendly
CLASS_COLORS = {
    0: "#2196F3",   # blue
    1: "#F44336",   # red
    2: "#4CAF50",   # green
    3: "#FF9800",   # orange
}

# ═══════════════════════════════════════════════════════════════════════════════
# MODEL  (exact copy from training script)
# ═══════════════════════════════════════════════════════════════════════════════

class TCNBlock(nn.Module):
    def __init__(self, in_ch, out_ch, dilation, dropout=DROPOUT_RATE):
        super().__init__()
        pad = (3 - 1) * dilation
        self.conv1 = nn.utils.parametrize if hasattr(nn.utils, 'parametrize') else nn.utils.weight_norm
        self.conv1 = nn.utils.weight_norm(
            nn.Conv1d(in_ch, out_ch, kernel_size=3, padding=pad, dilation=dilation))
        self.conv2 = nn.utils.weight_norm(
            nn.Conv1d(out_ch, out_ch, kernel_size=3, padding=pad, dilation=dilation))
        self.drop1 = nn.Dropout(dropout)
        self.drop2 = nn.Dropout(dropout)
        self.relu  = nn.ReLU()
        self.downsample = (nn.Conv1d(in_ch, out_ch, 1) if in_ch != out_ch else None)

    def forward(self, x):
        T   = x.size(2)
        out = self.conv1(x)[:, :, :T]
        out = self.relu(out)
        out = self.drop1(out)
        out = self.conv2(out)[:, :, :T]
        out = self.relu(out)
        out = self.drop2(out)
        res = x if self.downsample is None else self.downsample(x)
        return out + res


class TCNEncoder(nn.Module):
    def __init__(self, input_dim=6, embed_dim=64, dropout=DROPOUT_RATE):
        super().__init__()
        self.tcn = nn.Sequential(
            TCNBlock(input_dim, 32, dilation=1, dropout=dropout),
            TCNBlock(32,        32, dilation=2, dropout=dropout),
            TCNBlock(32,        64, dilation=4, dropout=dropout),
            TCNBlock(64,        64, dilation=8, dropout=dropout),
        )
        self.pool = nn.AdaptiveAvgPool1d(1)
        self.fc   = nn.Linear(64, embed_dim)

    def forward(self, x):
        x = x.transpose(1, 2)
        h = self.tcn(x)
        h = self.pool(h).squeeze(-1)
        return self.fc(h)


class MotionModelNet(nn.Module):
    def __init__(self):
        super().__init__()
        self.encoder    = TCNEncoder(input_dim=6, embed_dim=EMBEDDING_DIM)
        self.classifier = nn.Linear(EMBEDDING_DIM, 4)

    def forward(self, x):
        z      = self.encoder(x)
        logits = self.classifier(z)
        return z, logits


# ═══════════════════════════════════════════════════════════════════════════════
# FEATURE EXTRACTION  (identical to training)
# ═══════════════════════════════════════════════════════════════════════════════

def wrap_angle(angle):
    return (angle + np.pi) % (2 * np.pi) - np.pi


def extract_features(x, y, psi, dt=DT):
    """
    x, y, psi → 6-feature state vector matching training.
    Returns array of shape (T, 6). May be shorter than input by ~2 rows.
    """
    x   = x - x[0]
    y   = y - y[0]
    psi = wrap_angle(psi)

    dx   = np.diff(x) / dt
    dy   = np.diff(y) / dt
    dpsi = np.arctan2(np.sin(np.diff(psi)), np.cos(np.diff(psi))) / dt

    v       = np.sqrt(dx**2 + dy**2)
    psi_mid = psi[:-1]

    u  =  dx * np.cos(psi_mid) - dy * np.sin(psi_mid)
    vb = -dx * np.sin(psi_mid) + dy * np.cos(psi_mid)
    r  = dpsi
    dr = np.diff(r) / dt

    v_safe = v[:-1] + 1e-6
    kappa  = r[:-1] / v_safe

    min_len = min(len(v[:-1]), len(u[:-1]), len(vb[:-1]),
                  len(r[:-1]), len(dr), len(kappa))

    return np.stack([v[:min_len], u[:min_len], vb[:min_len],
                     r[:min_len], dr[:min_len], kappa[:min_len]], axis=1)


# ═══════════════════════════════════════════════════════════════════════════════
# SLIDING-WINDOW INFERENCE
# ═══════════════════════════════════════════════════════════════════════════════

def infer_trajectory(state, model, scaler, device, window_size=WINDOW_SIZE, stride=STRIDE):
    """
    Run sliding-window inference on a feature array (T, 6).
    Returns:
      window_preds  — class per window
      window_probs  — softmax probs per window  (N_windows, 4)
      window_centers — index of center of each window in state array
    """
    windows, centers = [], []
    for i in range(0, len(state) - window_size, stride):
        windows.append(state[i:i + window_size])
        centers.append(i + window_size // 2)

    if not windows:
        return np.array([]), np.array([]), np.array([])

    X = scaler.transform(
        np.array(windows).reshape(-1, state.shape[-1])
    ).reshape(len(windows), window_size, state.shape[-1])

    X_t = torch.tensor(X, dtype=torch.float32).to(device)
    model.eval()
    with torch.no_grad():
        _, logits = model(X_t)
        probs = torch.softmax(logits, dim=1).cpu().numpy()

    preds = probs.argmax(axis=1)
    return preds, probs, np.array(centers)


def smooth_predictions(centers, probs, total_len, n_classes=4):
    """
    Map window predictions back to per-timestep predictions via
    weighted averaging. Returns pred_per_step (total_len,) and
    prob_per_step (total_len, n_classes).
    """
    acc   = np.zeros((total_len, n_classes))
    count = np.zeros(total_len)

    for i, c in enumerate(centers):
        lo = max(0, c - WINDOW_SIZE // 2)
        hi = min(total_len, c + WINDOW_SIZE // 2)
        acc[lo:hi]   += probs[i]
        count[lo:hi] += 1

    # Fill any gaps with nearest neighbour
    mask = count == 0
    if mask.any():
        filled = np.where(~mask)[0]
        for idx in np.where(mask)[0]:
            nearest = filled[np.argmin(np.abs(filled - idx))]
            acc[idx]   = acc[nearest]
            count[idx] = 1

    prob_per_step = acc / count[:, None]
    pred_per_step = prob_per_step.argmax(axis=1)
    return pred_per_step, prob_per_step


# ═══════════════════════════════════════════════════════════════════════════════
# PAPER-QUALITY SINGLE TRAJECTORY PLOT
# ═══════════════════════════════════════════════════════════════════════════════

def plot_single_trajectory(x, y, pred_per_step, prob_per_step,
                            traj_id, true_label=None, out_path=None):
    """
    One trajectory coloured by predicted class at each point.
    Subplot layout:
      Left  — XY path coloured by class
      Right — class probability over time (stacked area)
    """
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
    fig.patch.set_facecolor("#FAFAFA")

    title = f"Vessel Trajectory  —  ID {traj_id}"
    if true_label is not None:
        title += f"   |   True: {CLASS_NAMES[int(true_label)]}"
    fig.suptitle(title, fontsize=13, fontweight="bold", y=1.01)

    # ── Left: XY path coloured by predicted class ──────────────────────────
    ax = axes[0]
    ax.set_facecolor("#F0F4F8")
    ax.grid(True, color="white", linewidth=1.2, zorder=0)

    n = min(len(x), len(pred_per_step))
    x, y = x[:n], y[:n]

    # Draw line segments coloured by class
    for cls in range(4):
        mask = pred_per_step[:n] == cls
        if not mask.any():
            continue
        # Find contiguous runs of this class
        idx = np.where(mask)[0]
        # Draw scatter dots (small, behind segments)
        ax.scatter(x[idx], y[idx],
                   c=CLASS_COLORS[cls], s=12, zorder=2,
                   label=CLASS_NAMES[cls], alpha=0.85)

    # Overlay a thin grey line for path continuity
    ax.plot(x, y, color="#CCCCCC", linewidth=0.8, zorder=1, alpha=0.6)

    # Start / end markers
    ax.plot(x[0],  y[0],  "^", color="black", ms=9, zorder=5, label="Start")
    ax.plot(x[-1], y[-1], "s", color="black", ms=9, zorder=5, label="End")

    ax.set_xlabel("X (m)", fontsize=11)
    ax.set_ylabel("Y (m)", fontsize=11)
    ax.set_title("Path coloured by predicted class", fontsize=11)
    ax.set_aspect("equal", "box")

    # Legend — classes + markers
    class_patches = [
        mpatches.Patch(color=CLASS_COLORS[c], label=CLASS_NAMES[c])
        for c in range(4)
    ]
    marker_handles = [
        plt.Line2D([0], [0], marker="^", color="black", ls="", ms=8, label="Start"),
        plt.Line2D([0], [0], marker="s", color="black", ls="", ms=8, label="End"),
    ]
    ax.legend(handles=class_patches + marker_handles,
              fontsize=9, loc="best", framealpha=0.9)

    # ── Right: class probability over time ─────────────────────────────────
    ax2 = axes[1]
    ax2.set_facecolor("#F0F4F8")
    ax2.grid(True, color="white", linewidth=1.2, zorder=0)

    t = np.arange(n) * DT
    # Stacked area chart
    bottom = np.zeros(n)
    for cls in range(4):
        p = prob_per_step[:n, cls]
        ax2.fill_between(t, bottom, bottom + p,
                         color=CLASS_COLORS[cls],
                         alpha=0.75, label=CLASS_NAMES[cls])
        bottom += p

    ax2.set_xlim(t[0], t[-1])
    ax2.set_ylim(0, 1)
    ax2.set_xlabel("Time (s)", fontsize=11)
    ax2.set_ylabel("Class Probability", fontsize=11)
    ax2.set_title("Predicted class probability over time", fontsize=11)
    ax2.legend(fontsize=9, loc="upper right", framealpha=0.9)

    plt.tight_layout()

    if out_path:
        os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)
        plt.savefig(out_path, dpi=200, bbox_inches="tight",
                    facecolor=fig.get_facecolor())
        print(f"[SAVED] {out_path}")
    plt.close()


# ═══════════════════════════════════════════════════════════════════════════════
# OVERVIEW PLOT  (all trajectories, small multiples)
# ═══════════════════════════════════════════════════════════════════════════════

def plot_overview(results, out_path=None):
    """
    Grid of small XY trajectory plots, one per traj_id.
    results: list of dicts with keys x, y, pred_per_step, traj_id, true_label
    """
    n     = len(results)
    ncols = min(4, n)
    nrows = math.ceil(n / ncols)

    fig, axes = plt.subplots(nrows, ncols,
                             figsize=(4.5 * ncols, 4.5 * nrows))
    fig.patch.set_facecolor("#FAFAFA")
    fig.suptitle("All Vessel Trajectories — Coloured by Predicted Class",
                 fontsize=14, fontweight="bold", y=1.01)

    axes_flat = np.array(axes).flatten() if n > 1 else [axes]

    for i, res in enumerate(results):
        ax  = axes_flat[i]
        x   = res["x"]
        y   = res["y"]
        prd = res["pred_per_step"]
        n_  = min(len(x), len(prd))

        ax.set_facecolor("#F0F4F8")
        ax.grid(True, color="white", linewidth=1.0)
        ax.plot(x[:n_], y[:n_], color="#CCCCCC", lw=0.7, zorder=1)

        for cls in range(4):
            mask = prd[:n_] == cls
            if mask.any():
                idx = np.where(mask)[0]
                ax.scatter(x[idx], y[idx],
                           c=CLASS_COLORS[cls], s=8,
                           label=CLASS_NAMES[cls], zorder=2, alpha=0.85)

        ax.plot(x[0],    y[0],    "^", color="black", ms=7, zorder=5)
        ax.plot(x[n_-1], y[n_-1], "s", color="black", ms=7, zorder=5)

        title = f"Traj {res['traj_id']}"
        if res.get("true_label") is not None:
            title += f"  (true: {CLASS_NAMES[int(res['true_label'])]})"
        ax.set_title(title, fontsize=9, fontweight="bold")
        ax.set_aspect("equal", "box")
        ax.tick_params(labelsize=7)
        ax.set_xlabel("X (m)", fontsize=8)
        ax.set_ylabel("Y (m)", fontsize=8)

    # Hide empty subplots
    for j in range(len(results), len(axes_flat)):
        axes_flat[j].set_visible(False)

    # Shared legend
    patches = [mpatches.Patch(color=CLASS_COLORS[c], label=CLASS_NAMES[c])
               for c in range(4)]
    patches += [
        plt.Line2D([0], [0], marker="^", color="black", ls="", ms=8, label="Start"),
        plt.Line2D([0], [0], marker="s", color="black", ls="", ms=8, label="End"),
    ]
    fig.legend(handles=patches, loc="lower center",
               ncol=6, fontsize=10, framealpha=0.9,
               bbox_to_anchor=(0.5, -0.02))

    plt.tight_layout()
    if out_path:
        os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)
        plt.savefig(out_path, dpi=200, bbox_inches="tight",
                    facecolor=fig.get_facecolor())
        print(f"[SAVED] {out_path}")
    plt.close()


# ═══════════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        description="Run TCN inference on trajectory CSVs and produce paper plots."
    )
    parser.add_argument("--csv",          required=True,
                        help="Path to CSV (test_trajectories.csv or ALL_BAGS_COMBINED.csv)")
    parser.add_argument("--model",        default=MODEL_PATH)
    parser.add_argument("--scaler",       default=SCALER_PATH)
    parser.add_argument("--out",          default="paper_plots",
                        help="Output directory")
    parser.add_argument("--traj_ids",     nargs="*", type=int, default=None,
                        help="Specific traj_ids to process (default: all)")
    parser.add_argument("--no_true_label", action="store_true",
                        help="Set if CSV has no 'label' column (bag-extracted data)")
    parser.add_argument("--traj_col",     default="traj_id",
                        help="Column name for trajectory ID (default: traj_id)")
    args = parser.parse_args()

    os.makedirs(args.out, exist_ok=True)

    # ── Load data ─────────────────────────────────────────────────────────────
    print(f"[INFO] Loading {args.csv} ...")
    df = pd.read_csv(args.csv)
    print(f"[INFO] Columns: {df.columns.tolist()}")
    print(f"[INFO] {df[args.traj_col].nunique()} trajectories found")

    has_label = ("label" in df.columns) and not args.no_true_label

    # ── Load model ────────────────────────────────────────────────────────────
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"[INFO] Device: {device}")

    model = MotionModelNet().to(device)
    model.load_state_dict(torch.load(args.model, map_location=device))
    model.eval()
    print(f"[INFO] Model loaded from {args.model}")

    scaler = joblib.load(args.scaler)
    print(f"[INFO] Scaler loaded from {args.scaler}")

    # ── Process trajectories ──────────────────────────────────────────────────
    traj_ids = args.traj_ids or sorted(df[args.traj_col].unique())
    results  = []
    summary  = []

    for traj_id in traj_ids:
        traj = df[df[args.traj_col] == traj_id].copy()
        if len(traj) < WINDOW_SIZE + 5:
            print(f"[SKIP] traj {traj_id}: too short ({len(traj)} rows)")
            continue

        x   = traj["x"].values
        y   = traj["y"].values
        psi = traj["heading"].values if "heading" in traj.columns else \
              traj["heading_deg"].values * np.pi / 180.0

        true_label = int(traj["label"].iloc[0]) if has_label else None

        # Feature extraction
        state = extract_features(x, y, psi)
        if len(state) < WINDOW_SIZE:
            print(f"[SKIP] traj {traj_id}: features too short after extraction")
            continue

        # Inference
        w_preds, w_probs, w_centers = infer_trajectory(state, model, scaler, device)
        if len(w_preds) == 0:
            print(f"[SKIP] traj {traj_id}: no windows generated")
            continue

        # Map back to per-timestep (aligned with state, not raw x/y)
        pred_per_step, prob_per_step = smooth_predictions(
            w_centers, w_probs, len(state))

        # Trajectory-level prediction (confidence-weighted vote)
        weights    = w_probs.max(axis=1)
        wprobs     = (w_probs * weights[:, None]).sum(axis=0)
        traj_pred  = int(wprobs.argmax())
        traj_conf  = float(wprobs.max() / wprobs.sum())

        print(f"[traj {traj_id}]  pred={CLASS_NAMES[traj_pred]}"
              + (f"  true={CLASS_NAMES[true_label]}" if true_label is not None else "")
              + f"  conf={traj_conf:.2f}")

        # Align x/y with state (state is 2 rows shorter than raw)
        n_align = min(len(x), len(pred_per_step))
        x_a, y_a = x[:n_align], y[:n_align]

        # Individual plot
        plot_single_trajectory(
            x_a, y_a, pred_per_step, prob_per_step,
            traj_id=traj_id, true_label=true_label,
            out_path=os.path.join(args.out, f"traj_{traj_id}.png")
        )

        results.append({
            "traj_id":       traj_id,
            "x":             x_a,
            "y":             y_a,
            "pred_per_step": pred_per_step,
            "true_label":    true_label,
        })

        summary.append({
            "traj_id":    traj_id,
            "true_label": true_label if true_label is not None else "N/A",
            "pred_label": traj_pred,
            "pred_name":  CLASS_NAMES[traj_pred],
            "confidence": round(traj_conf, 4),
            "correct":    (traj_pred == true_label) if true_label is not None else "N/A",
        })

    # ── Overview plot ─────────────────────────────────────────────────────────
    if results:
        plot_overview(results, out_path=os.path.join(args.out, "overview_all_trajectories.png"))

    # ── Summary CSV ───────────────────────────────────────────────────────────
    summary_df = pd.DataFrame(summary)
    summary_path = os.path.join(args.out, "inference_summary.csv")
    summary_df.to_csv(summary_path, index=False)
    print(f"\n[SAVED] {summary_path}")

    if has_label and len(summary) > 0:
        correct = sum(1 for s in summary if s["correct"] is True)
        print(f"\n[RESULT] Trajectory-level accuracy: {correct}/{len(summary)} "
              f"= {100*correct/len(summary):.1f}%")

    print(f"\n[DONE] All outputs in: {args.out}/")


if __name__ == "__main__":
    main()
