# REPORT WRITER
# =============================================================
def write_report(all_results):
    lines = []
    lines.append("=" * 65)
    lines.append("  THERMAL CANTHUS DIAGNOSTIC REPORT")
    lines.append(f"  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    lines.append("=" * 65)
    lines.append("")

    n_pass = n_warn = n_fail = 0
    for sc_id, sc_label, samples, status, notes, issues in all_results:
        m = {"PASS": "PASS", "WARN": "WARN", "FAIL": "FAIL"}.get(status, "?")
        lines.append(f"[{m}] Scenario {sc_id} — {sc_label}")
        lines.append(f"      Samples captured: {len(samples)}")
        for note in notes:
            lines.append(f"      {note}")
        if issues:
            lines.append("      ISSUES:")
            for iss in issues:
                lines.append(f"        !! {iss}")
        lines.append("")
        lines.append("-" * 65)
        lines.append("")
        if status == "PASS":   n_pass += 1
        elif status == "WARN": n_warn += 1
        else:                  n_fail += 1

    lines.append(f"SUMMARY:  PASS={n_pass}  WARN={n_warn}  FAIL={n_fail}")
    lines.append("")
    lines.append("LAYER DIAGNOSIS")
    lines.append("")

    all_issues_str = " ".join(
        iss for *_, _, issues in all_results for iss in issues).lower()

    def layer(name, failed, action):
        if failed:
            lines.append(f"  !! {name}:  PROBLEM")
            lines.append(f"     {action}")
        else:
            lines.append(f"  OK {name}")
        lines.append("")

    layer("Layer 1 — Model weights",
          any(sc == "A" and st == "FAIL"
              for sc, _, _, st, _, _ in all_results),
          "Failing at arm's length = weak model. Check weights or retrain.")

    layer("Layer 2 — SAHI tile geometry / distance",
          any(sc == "C" and st == "FAIL"
              for sc, _, _, st, _, _ in all_results),
          "Failing at 3m = tiles too large. Add smaller tier, raise upscale.")

    layer("Layer 3 — Post-processing (symmetry / single-canthus)",
          any(sc in ("D","E","F","G") and st == "FAIL"
              for sc, _, _, st, _, _ in all_results),
          "Failing on turns/occlusion. Fix symmetry fallback logic.")

    layer("Layer 4 — Ghost / false-positive detections",
          "ghost" in all_issues_str or "false positive" in all_issues_str,
          "Add hard conf floor in NMS, tighten IoU threshold.")

    layer("Layer 5 — Distance + angle combined (hardest case)",
          any(sc == "H" and st == "FAIL"
              for sc, _, _, st, _, _ in all_results),
          "Failing at 3m + turn = needs Layer 2 AND Layer 3 fixes both.")

    lines.append("=" * 65)
    report = "\n".join(lines)

    with open(REPORT_PATH, "w") as f:
        f.write(report)
    print("\n" + report)
    print(f"\nReport: {REPORT_PATH}")


